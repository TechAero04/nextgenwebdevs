# Supabase (Sign up / Login) — Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Contact form email delivery (https://resend.com) — verify nextgenwebdevs.com as a sending domain
RESEND_API_KEY=
CONTACT_FROM_EMAIL=NextGenWebDevs <no-reply@nextgenwebdevs.com>

# Payment links (Stripe Payment Links / Paddle / Airwallex checkout) — add after payment approval.
# When empty, the dashboard shows a "Request invoice" button that emails billing@.
CHECKOUT_URL_STARTER_MONTHLY=
CHECKOUT_URL_STARTER_YEARLY=
CHECKOUT_URL_PRO_MONTHLY=
CHECKOUT_URL_PRO_YEARLY=
CHECKOUT_URL_AGENCY_MONTHLY=
CHECKOUT_URL_AGENCY_YEARLY=
